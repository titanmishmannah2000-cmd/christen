# Keys for the copyrighted Bibles, read from their publishers' own services.
# Leave a key empty and that Bible shows as "Not set up yet" in Settings.
# The keys are in your own name; the app must stay free (no price, ads or donations).

# ESV: make an account at https://api.esv.org/ and create an application.
VITE_ESV_KEY=

# NASB and CSB: make an account at https://api.bible/ (Starter plan), then add
# the NASB and CSB to your app in the dashboard.
VITE_API_BIBLE_KEY=
# Optional: the API address shown in the dashboard, if it differs from https://rest.api.bible/v1
VITE_API_BIBLE_URL=
# NASB: set its id ONLY once the NASB is part of your own API.Bible plan or Lockman has given
# permission. Left empty, it shows greyed out as "Not set up yet". The CSB id is optional.
VITE_API_BIBLE_NASB_ID=
VITE_API_BIBLE_CSB_ID=
# Optional: the NIV's id, if the app picks the wrong edition.
VITE_API_BIBLE_NIV_ID=
